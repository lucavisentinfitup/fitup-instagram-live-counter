# Instagram Graph API (ufficiale): token di lunga durata dell'utente di sistema del Business Manager FitUP
INSTAGRAM_ACCESS_TOKEN=
# ID dell'account Instagram Business di fitup.it (non la pagina Facebook)
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=fitup.it
# account interrogabili con ?username= (l'endpoint è pubblico)
ALLOWED_USERNAMES=^fitup[._a-z0-9]*$
CACHE_TTL_SECONDS=5
CLUB_CACHE_TTL_SECONDS=600
GRAPH_VERSION=v21.0
